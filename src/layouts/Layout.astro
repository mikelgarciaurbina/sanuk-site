---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { storeUrls } from '../data/content';

interface Props { title: string; description: string; path?: string; noindex?: boolean; }
const { title, description, path = Astro.url.pathname, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(path === '/' ? '/' : `${path.replace(/\/$/, '')}/`, Astro.site).href : undefined;
const image = new URL('/img/social-card.png', Astro.site ?? Astro.url).href;
const imageAlt = 'Sanuk. Thai, curva a curva. Aprende tailandés desde el español.';
const home = Astro.site?.href;
const schema = home && path === '/' ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Sanuk',
      url: home,
      inLanguage: 'es',
      about: { '@id': new URL('#app', home).href },
    },
    {
      '@type': 'MobileApplication',
      '@id': new URL('#app', home).href,
      name: 'Sanuk',
      url: home,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'iOS, Android',
      inLanguage: 'es',
      description,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      installUrl: Object.values(storeUrls),
    },
  ],
} : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F6FA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    {(noindex || !Astro.site) && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Sanuk" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
