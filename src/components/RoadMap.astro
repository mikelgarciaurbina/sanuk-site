---
// Carretera que serpentea de abajo (Chiang Mai) a arriba (el pueblo). Puntos calculados en build.
const W = 420, H = 680, N = 14;
const pt = (t: number) => ({ x: 210 + 128 * Math.sin(t * Math.PI * 6) * (0.55 + 0.45 * Math.sin(t * Math.PI)), y: 620 - t * 560 });
const samples = Array.from({ length: 241 }, (_, i) => pt(i / 240));
const d = samples.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
const dots = Array.from({ length: N }, (_, i) => ({ n: i + 1, ...pt(i / (N - 1)) }));
---
<figure class="rm">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mapa de la carretera de Chiang Mai al pueblo de Yai, con 14 paradas y 1.864 curvas">
    <rect width={W} height={H} rx="32" fill="#E8EEF5" />
    <path d="M0 250 L90 190 L170 235 L270 160 L360 225 L420 195 V560 H0Z" fill="#C9D6E4" />
    <path d="M0 420 L80 360 L170 410 L280 340 L360 405 L420 370 V680 H0Z" fill="#9CBFB3" opacity=".8" />
    <path d={d} fill="none" stroke="#B7C5D6" stroke-width="30" stroke-linecap="round" stroke-linejoin="round" />
    <path d={d} fill="none" stroke="#fff" stroke-width="22" stroke-linecap="round" stroke-linejoin="round" />
    <path d={d} fill="none" stroke="#B7C5D6" stroke-width="3" stroke-dasharray="3 12" stroke-linecap="round" />
    {dots.map((p) => (
      <g>
        <circle cx={p.x} cy={p.y} r="15" fill={p.n === N ? '#FF6A3D' : p.n === 1 ? '#13854F' : '#FFA41B'} stroke="#fff" stroke-width="3" />
        <text x={p.x} y={p.y + 5} text-anchor="middle" font-family="Nunito Variable, sans-serif" font-weight="900" font-size="14" fill={p.n === 1 ? '#fff' : '#1D2347'}>{p.n}</text>
      </g>
    ))}
    <g class="fog">
      <rect x="-40" y="130" width="360" height="30" rx="15" fill="#fff" opacity=".7" />
      <rect x="140" y="215" width="330" height="26" rx="13" fill="#fff" opacity=".6" />
      <rect x="-60" y="300" width="330" height="26" rx="13" fill="#fff" opacity=".55" />
    </g>
    <text x="210" y="664" text-anchor="middle" font-family="Fredoka Variable, sans-serif" font-weight="600" font-size="17" fill="#1D2347">Chiang Mai · curva 0</text>
    <text x="210" y="32" text-anchor="middle" font-family="Fredoka Variable, sans-serif" font-weight="600" font-size="17" fill="#1D2347">El pueblo · curva 1.864</text>
  </svg>
  <figcaption class="sr-only">Las 14 paradas aparecen listadas a continuación.</figcaption>
</figure>

<style>
  .rm { margin: 0; max-width: 440px; margin-inline: auto; width: 100%; }
  svg { width: 100%; height: auto; display: block; border-radius: var(--r-xxl); box-shadow: 0 6px 0 var(--niebla-3), var(--sombra-card); }
  .fog { animation: fog 18s ease-in-out infinite alternate; }
  @keyframes fog { from { transform: translateX(-24px); } to { transform: translateX(30px); } }
</style>
