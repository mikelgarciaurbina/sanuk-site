---
import { letter } from '../data/content';
const total = letter.reduce((sum, line) => sum + line.toks.length, 0);
---
<div class="ld" id="carta-demo">
  <div class="ld-ctrl">
    <p class="ld-instructions">Revela las palabras una a una o lee la carta completa con su traducción.</p>
    <button type="button" class="btn" data-learn>Revelar una palabra</button>
    <button type="button" class="btn btn-ghost btn-sm" data-all>Leer la carta completa</button>
    <button type="button" class="btn btn-ghost btn-sm" data-reset>Empezar de nuevo</button>
    <label class="ld-range">
      <span id="carta-progreso">Palabras visibles <b data-n>0</b> de {total}</span>
      <input type="range" min="0" max={total} value="0" step="1" data-range aria-label="Palabras visibles" />
    </label>
    <p class="ld-pct"><span aria-hidden="true">Carta revelada · <b data-pct>0</b> %</span><span class="sr-only" role="status" aria-atomic="true" data-announcement></span></p>
  </div>

  <article class="paper" aria-label="Carta de Yai en tailandés con traducción al español">
    <p class="paper-head" lang="th-TH">จดหมายจากยาย</p>
    {letter.map((l) => (
      <div class="line">
        <div class="toks">
          {l.toks.map((t) => (
            <div class="w">
              <p class="w-th th" lang="th-TH" tabindex="-1">{t.t}</p>
              <p class="w-rom" lang="th-Latn">{t.r}</p>
              <p class="w-es" lang="es-ES">{t.g}</p>
            </div>
          ))}
        </div>
        <p class="es" lang="es-ES">«{l.es}»</p>
      </div>
    ))}
    <button type="button" class="btn btn-sm ld-next" data-next aria-describedby="carta-progreso" hidden>Revelar la siguiente palabra</button>
  </article>
  <p class="ld-end">Has llegado. Yai te ata el hilo blanco en la muñeca (<span class="th" lang="th">ผูกข้อมือ</span>) y ya sabes qué contestar.</p>
</div>

<style>
  .ld-ctrl { display: flex; flex-wrap: wrap; gap: 14px 16px; align-items: center; margin-bottom: 28px; }
  .ld-range { display: grid; gap: 4px; flex: 1 1 260px; font-weight: 800; }
  .ld-range input { width: 100%; accent-color: var(--arrozal-hondo); height: 44px; }
  .ld-pct { margin: 0; font-family: var(--f-display); font-weight: 700; font-size: 1.5rem; flex-basis: 100%; }
  .ld-pct b { color: var(--arrozal-hondo); font-variant-numeric: tabular-nums; }
  .ld-instructions { flex-basis: 100%; margin: 0; }
  .ld:not([data-js]) .ld-ctrl { display: none; }

  .paper { background: #fffdf7; border-radius: 10px; padding: clamp(20px, 4vw, 40px); max-width: 760px; margin-inline: auto; box-shadow: 0 4px 0 var(--niebla-3), 0 18px 36px rgb(29 35 71 / .16); position: relative; }
  .paper::before { content: ''; position: absolute; top: -12px; left: 50%; width: 90px; height: 26px; margin-left: -45px; background: rgb(255 200 61 / .75); transform: rotate(2deg); border-radius: 4px; }
  .paper-head { font-weight: 700; font-size: 1.1rem; color: var(--tinta-2); margin-bottom: 1.4em; }
  .line { margin: 0 0 1.5em; }
  .toks { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .w { position: relative; display: inline-flex; flex-direction: column; align-items: center; padding: 0 2px; border-radius: 8px; }
  .w-th { font-size: clamp(1.35rem, 4.4vw, 1.8rem); line-height: 1.5; font-weight: 500; transition: filter var(--dur-lento) ease-out; }
  .w p { margin: 0; }
  .w-rom, .w-es { line-height: 1.2; font-size: .9rem; transition: opacity var(--dur-lento) ease-out; }
  .w .w-rom { margin-top: 2px; font-style: italic; color: var(--tinta-2); }
  .w-es { font-weight: 900; color: var(--arrozal-hondo); }
  .es { margin: .6em 0 0; font-weight: 700; color: var(--tinta-2); }

  /* niebla: solo con JS activo; sin JS todo se lee */
  .ld[data-js] .w::after { content: ''; position: absolute; inset: -2px; border-radius: 8px; background: rgb(255 255 255 / .78); transform-origin: left center; transform: scaleX(1); transition: transform var(--dur-lento) ease-out; pointer-events: none; }
  .ld[data-js] .w:not(.on) .w-th { filter: blur(6px); }
  .ld[data-js] .w:not(.on) :is(.w-rom, .w-es) { opacity: 0; }
  .ld-next { margin-bottom: 1.5rem; }
  .ld[data-js] .w.on::after { transform: scaleX(0); transform-origin: right center; }
  .ld[data-js] .line:not(.done) .es { opacity: 0; transition: opacity var(--dur-lento); }
  .ld[data-js] .line.done .es { opacity: 1; }
  .w.pop .w-th { animation: wpop var(--dur-lento) var(--ease-pop); }
  @keyframes wpop { 40% { transform: translateY(-4px) scale(1.08); } }
  .ld-end { max-width: 760px; margin: 28px auto 0; font-family: var(--f-display); font-size: 1.2rem; font-weight: 600; display: none; background: var(--arrozal-suave); padding: 14px 20px; border-radius: var(--r-l); }
  .ld:not([data-js]) .ld-end, .ld.complete .ld-end { display: block; }
</style>

<script>
  const root = document.getElementById('carta-demo');
  if (root) {
    const words = Array.from(root.querySelectorAll<HTMLElement>('.w'));
    const lines = Array.from(root.querySelectorAll<HTMLElement>('.line'));
    const total = words.length;
    const range = root.querySelector<HTMLInputElement>('[data-range]')!;
    const nEl = root.querySelector<HTMLElement>('[data-n]')!;
    const pctEl = root.querySelector<HTMLElement>('[data-pct]')!;
    const learn = root.querySelector<HTMLButtonElement>('[data-learn]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const reduce = () => motion.matches || document.documentElement.dataset.motion === 'paused';
    const announcement = root.querySelector<HTMLElement>('[data-announcement]')!;
    let n = 0;
    const showAll = root.querySelector<HTMLButtonElement>('[data-all]')!;

    const set = (value: number) => {
      const prev = n;
      n = Math.max(0, Math.min(total, value));
      words.forEach((word, index) => {
        const visible = index < n;
        word.classList.toggle('on', visible);
        word.inert = !visible;
        word.classList.toggle('pop', visible && index >= prev && !reduce());
      });
      lines.forEach((line) => {
        const complete = !line.querySelector('.w:not(.on)');
        line.classList.toggle('done', complete);
        line.querySelector('.es')!.setAttribute('aria-hidden', String(!complete));
      });

      range.value = String(n);
      range.setAttribute('aria-valuetext', `${n} de ${total} palabras visibles`);
      nEl.textContent = String(n);
      pctEl.textContent = String(Math.round((n / total) * 100));
      learn.setAttribute('aria-disabled', String(n === total));
      next.hidden = n === 0 || n === total;
      if (!next.hidden) {
        const line = words[n - 1]!.closest('.line')!;
        if (line.nextElementSibling !== next) line.after(next);
      }
      root.classList.toggle('complete', n === total);
    };

    const revealWord = () => {
      if (n === total) return;
      const word = words[n]!;
      announcement.replaceChildren();
      set(n + 1);
      // Android flattens multilingual live announcements. Let the reader start
      // at the Thai paragraph and navigate its language-tagged siblings.
      word.querySelector<HTMLElement>('.w-th')!.focus();
    };
    learn.addEventListener('click', revealWord);
    next.addEventListener('click', revealWord);
    showAll.addEventListener('click', () => {
      set(total);
      announcement.textContent = 'Carta completa. Puedes leer todas las palabras y su traducción.';
    });
    reset.addEventListener('click', () => {
      set(0);
      announcement.textContent = 'Has vuelto al principio de la carta.';
    });
    range.addEventListener('input', () => {
      announcement.replaceChildren();
      set(Number(range.value));
    });
    set(0);
    root.setAttribute('data-js', '');
  }
</script>
