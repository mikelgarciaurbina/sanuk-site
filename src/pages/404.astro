---
import Layout from '../layouts/Layout.astro';
import Noi from '../components/Noi.astro';
---
<Layout title="Página no encontrada · Sanuk" description="Vuelve al inicio de Sanuk para encontrar la ruta de aprendizaje y los juegos de tailandés." path="/404" noindex>
  <section class="nf">
    <div class="wrap">
      <Noi pose="ups" size={200} />
      <p class="eyebrow">Error 404</p>
      <h1>Página no encontrada</h1>
      <p class="lead"><span class="th" lang="th">ไม่เป็นไร</span> <span class="rom">mâi pen rai</span>: no pasa nada. Noi te acompaña de vuelta al inicio.</p>
      <p><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Layout>
<style>
  .nf { text-align: center; padding: 64px 0 96px; }
  .nf :global(.noi) { margin-bottom: 8px; }
</style>
