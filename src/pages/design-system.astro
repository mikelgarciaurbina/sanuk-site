        <thead><tr><th scope="col">Evitamos</th><th scope="col">Decimos</th></tr></thead>
        <tbody>
          <tr><td class="no">Respuesta incorrecta.</td><td class="yes">Casi. Se dice <span class="th" lang="th">ข้าว</span>.</td></tr>
          <tr><td class="no">Has perdido una vida.</td><td class="yes">No pasa nada, otra vez.</td></tr>
          <tr><td class="no">¡Vuelve o perderás tu racha!</td><td class="yes">El farolillo te espera.</td></tr>
          <tr><td class="no">Nivel completado.</td><td class="yes">Otra curva menos. Ya casi huele a café.</td></tr>
        </tbody>
      </table></div>
    </div>
  </section>
</Layout>

