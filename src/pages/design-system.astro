---
import Layout from '../layouts/Layout.astro';
import Noi from '../components/Noi.astro';
import { color, tones, motion } from '../brand/tokens';
import { NOI_POSES, noiParts } from '../brand/noi-art';
import { toneRows } from '../data/content';

// ——— utilidades de build: contraste y muelles físicos → easing linear() ———
const lum = (hex: string) => {
  const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0]! + 0.7152 * c[1]! + 0.0722 * c[2]!;
};
const ratio = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
  return (x! + 0.05) / (y! + 0.05);
};
const spring = ({ stiffness: k, damping: c, mass: m }: { stiffness: number; damping: number; mass: number }) => {
  const dt = 1 / 120; let x = 0, v = 0; const pts: number[] = []; let t = 0;
  while (t < 1.4) { const a = (-k * (x - 1) - c * v) / m; v += a * dt; x += v * dt; t += dt; if (Math.round(t / dt) % 4 === 0) pts.push(+x.toFixed(3)); }
  pts.push(1);
  return { css: `linear(0, ${pts.join(', ')})`, ms: Math.round(t * 1000) };
};
const springs = [
  { id: 'pop', name: 'pop', use: 'Botones, fichas, aciertos. Rápido y con un rebote corto.', p: motion.pop },
  { id: 'boing', name: 'boing', use: 'Celebraciones y sellos. Se pasa un poco y vuelve: alegría.', p: motion.boing },
  { id: 'trompa', name: 'trompa', use: 'Noi y movimientos grandes. Lento, pesado, sin rebote: 1.200 kilos.', p: motion.trompa },
].map((s) => ({ ...s, ...spring(s.p) }));

const swatch = (n: string, key: keyof typeof color, why: string) => ({ n, key, hex: color[key] as string, why });
const groups = [
  { t: 'Fondos', d: 'La mañana en la montaña. El fondo nunca compite con lo que aprendes.', items: [
    swatch('niebla', 'niebla', 'La mañana en las montañas de Mae Hong Son. Es el fondo de todo.'),
    swatch('niebla 2', 'niebla2', 'La niebla un poco más densa: superficies hundidas y bandas de sección.'),
    swatch('niebla 3', 'niebla3', 'Bordes y sombras de las tarjetas.'),
    swatch('niebla 4', 'niebla4', 'La carretera y los detalles tenues del paisaje.'),
  ] },
  { t: 'Texto', d: 'Índigo en vez de negro: más cálido, más humano.', items: [
    swatch('tinta', 'tinta', 'El índigo de la camisa mo hom que se viste en el norte. Todo el texto principal.'),
    swatch('tinta 2', 'tinta2', 'Texto secundario, siempre por encima de 4,5:1 sobre niebla.'),
    swatch('tinta 3', 'tinta3', 'Texto terciario y etiquetas pequeñas.'),
  ] },
  { t: 'Acción', d: 'Si es azafrán, se toca.', items: [
    swatch('azafrán', 'azafran', 'Las túnicas de los monjes. Reservado a la acción principal de cada pantalla.'),
    swatch('azafrán hondo', 'azafranHondo', 'El pliegue de la túnica: la sombra de 5 px que da peso al botón.'),
    swatch('azafrán suave', 'azafranSuave', 'Fondos cálidos y avisos amables.'),
  ] },
  { t: 'Acierto y progreso', d: 'El arrozal después de la lluvia.', items: [
    swatch('arrozal', 'arrozal', 'Verde de arrozal: acierto y progreso.'),
    swatch('arrozal hondo', 'arrozalHondo', 'Sombra y texto sobre fondo suave.'),
    swatch('arrozal vivo', 'arrozalVivo', 'El brote nuevo: barras de progreso.'),
    swatch('arrozal suave', 'arrozalSuave', 'Fondo de la hoja de acierto.'),
  ] },
  { t: 'Racha y recompensa', d: 'Luz en el cielo: farolillos y flores.', items: [
    swatch('farol', 'farol', 'Los khom loy que suben al cielo en Yi Peng. Es la racha diaria.'),
    swatch('buatong', 'buatong', 'Los girasoles buatong de Doi Mae U-Kho: recompensas y plátanos.'),
    swatch('buatong hondo', 'buatongHondo', 'Sombra de las recompensas.'),
  ] },
  { t: 'Error amable', d: 'Un rojo que corrige sin gritar.', items: [
    swatch('laca', 'laca', 'La laca roja Lanna de los templos. Rojo de objeto precioso, no de alarma.'),
    swatch('laca hondo', 'lacaHondo', 'Texto sobre el fondo suave.'),
    swatch('laca suave', 'lacaSuave', 'Fondo de la hoja de error.'),
  ] },
  { t: 'Selección y audio', d: 'El cielo despejado.', items: [
    swatch('cielo', 'cielo', 'Lo que está seleccionado y todo lo que suena.'),
    swatch('cielo hondo', 'cieloHondo', 'Sombra y enlaces.'),
    swatch('cielo suave', 'cieloSuave', 'Fondo de la ficha seleccionada.'),
  ] },
  { t: 'Textil y noche', d: 'Azul de tela y de cielo nocturno.', items: [
    swatch('mo hom', 'mohom', 'Azul mo hom, la mochila de Noi y las camisas del campo.'),
    swatch('noche', 'noche', 'Modo noche y pie de página.'),
    swatch('noche 2', 'noche2', 'Superficies sobre la noche.'),
  ] },
  { t: 'Mascota y madera', d: 'Piel de elefanta y teca.', items: [
    swatch('noi', 'noi', 'La piel de Noi: melocotón, con pecas rosas.'),
    swatch('teca', 'teca', 'Madera de teca: puentes, tablas y el «tok».'),
    swatch('teca suave', 'tecaSuave', 'Fondos de madera clara.'),
  ] },
  { t: 'Paisaje', d: 'Cuatro montañas y un amanecer. Capas planas, sin degradados.', items: [
    swatch('monte 1', 'monte1', 'La cresta más lejana, casi niebla.'),
    swatch('monte 2', 'monte2', 'Verde azulado de la distancia.'),
    swatch('monte 3', 'monte3', 'La ladera media.'),
    swatch('monte 4', 'monte4', 'La ladera cercana, la más viva.'),
    swatch('alba', 'alba', 'El sol de primera hora. Aparece detrás de las montañas.'),
  ] },
];
const poseUse: Record<string, string> = {
  feliz: 'Estado por defecto y aciertos pequeños.', hola: 'Bienvenida, inicio de sesión del día.', celebra: 'Fin de lección, sellos, racha nueva.',
  piensa: 'Pistas y preguntas difíciles.', ups: 'Error sin culpa: «no pasa nada».', duerme: 'Racha en pausa, vuelta tras días sin entrar.', escucha: 'Audio y grabación de voz.',
};
const nav = ['color', 'tonos', 'tipografia', 'componentes', 'movimiento', 'sonido', 'haptica', 'noi', 'voz'];
const navL = ['Color', 'Tonos', 'Tipografía', 'Componentes', 'Movimiento', 'Sonido', 'Háptica', 'Noi', 'Voz'];
const layers = noiParts('feliz').map((p) => p.id);
---
<Layout title="Sistema de diseño · Sanuk" description="Por qué cada color, tono, tipografía, componente, movimiento y sonido de Sanuk sale del viaje de Chiang Mai a Mae Hong Son.">
  <section class="intro">
    <div class="wrap intro-in">
      <div>
        <p class="eyebrow">Sistema de diseño</p>
        <h1>Todo sale del camino</h1>
        <p class="lead">Ningún color, sonido ni movimiento de Sanuk está elegido al azar: cada uno viene de algo que verías, oirías o tocarías entre Chiang Mai y Mae Hong Son. Aquí está el porqué.</p>
      </div>
      <Noi pose="piensa" size={200} />
    </div>
    <nav class="wrap toc" aria-label="Secciones">
      {nav.map((id, i) => <a class="btn btn-ghost btn-sm" href={`#${id}`}>{navL[i]}</a>)}
    </nav>
  </section>

  <!-- COLOR -->
  <section class="section" id="color">
    <div class="wrap">
      <p class="eyebrow">01 · Color</p>
      <h2>Colores con historia</h2>
      <p class="lead">Cada color lleva el nombre de lo que lo inspiró. Si alguien duda de qué color usar, pregunta qué pasa en la historia.</p>
      {groups.map((g) => (
        <div class="cg">
          <h3>{g.t}</h3>
          <p class="cg-d">{g.d}</p>
          <ul class="sw-list">
            {g.items.map((s) => {
              const onT = ratio(s.hex, color.tinta), onW = ratio(s.hex, '#FFFFFF');
              const fg = onT >= onW ? color.tinta : '#FFFFFF';
              return (
                <li class="sw">
                  <div class="chipc" style={`background:${s.hex};color:${fg}`}><b>{s.n}</b><span class="mono">{s.hex}</span><small>{Math.max(onT, onW).toFixed(1)}:1 con {onT >= onW ? 'tinta' : 'blanco'}</small></div>
                  <p>{s.why}</p>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- TONOS -->
  <section class="section alt" id="tonos">
    <div class="wrap">
      <p class="eyebrow">02 · Los 5 tonos</p>
      <h2>Cinco tonos, cinco colores</h2>
      <p class="lead">En thai, el mismo sonido cambia de significado según el tono. Por eso cada tono tiene su propio color y su propio trazo: el oído se apoya en el ojo.</p>
      <p>Cada uno combina tres pistas: el <strong>contorno</strong> dibuja cómo sube o baja la voz, el <strong>color</strong> lo distingue de un vistazo y la <strong>palabra de ejemplo</strong> lo ancla a algo real.</p>
      <div class="table-wrap">
        <table class="tones">
          <caption class="sr-only">Los cinco tonos del thai con su color, contorno y palabra de ejemplo</caption>
          <thead><tr><th scope="col">Tono</th><th scope="col">Contorno</th><th scope="col">Color</th><th scope="col">Ejemplo</th></tr></thead>
          <tbody>
            {toneRows.map((r) => {
              const t = tones[r.id];
              return (
                <tr>
                  <th scope="row">{t.name} <span class="th" lang="th">{t.thai}</span></th>
                  <td><svg viewBox="0 0 24 14" width="72" height="42" aria-hidden="true"><path d={t.path} fill="none" stroke={t.fill} stroke-width="2.6" stroke-linecap="round" /></svg></td>
                  <td><span class="tchip" style={`background:${t.fill};color:${t.on}`}><b class="mono">{t.fill}</b></span></td>
                  <td><span class="th ex" lang="th" style={`color:${t.text}`}>{r.word}</span> <span class="rom">{r.rom}</span> · «{r.es}»</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="note">Los colores de relleno sirven para fichas y contornos. Cuando el tono se escribe como texto sobre blanco se usa una variante más oscura, para cumplir el contraste de 4,5:1.</p>
    </div>
  </section>

  <!-- TIPOGRAFÍA -->
  <section class="section" id="tipografia">
    <div class="wrap">
      <p class="eyebrow">03 · Tipografía</p>
      <h2>Tres voces</h2>
      <div class="grid g3 type">
        <article class="card"><p class="eyebrow">Fredoka · 600–700</p><p class="big disp">Thai, curva a curva</p><p>Redondeada y con peso: es la voz de Noi. Titulares, números y momentos de alegría.</p></article>
        <article class="card"><p class="eyebrow">Nunito · 600–900</p><p class="big ui">Aprende una palabra nueva</p><p>Amable y muy legible en tamaños pequeños. Botones, etiquetas y texto corrido.</p></article>
        <article class="card"><p class="eyebrow">Noto Sans Thai Looped</p><p class="big th" lang="th">สวัสดี ขอบคุณ</p><p>Todo el texto thai. Los bucles son deliberados (ver abajo).</p></article>
      </div>
      <div class="why card">
        <h3>¿Por qué el thai con «lazos»?</h3>
        <p>Muchas letras thai se escriben empezando por un bucle: ก, ข, ค, ท. Las fuentes modernas «sin lazos» (como las de las señales de tráfico) los eliminan y parecen más limpias, pero no son lo que se enseña en los colegios tailandeses. Para quien empieza, el bucle es la pista de por dónde empezar el trazo y ayuda a distinguir letras casi iguales como ถ y ภ.</p>
        <p class="th cmp" lang="th"><span>ก ข ค ท พ ผ ม</span></p>
        <p class="small">Mostramos el thai siempre con los lazos, aunque la interfaz sea moderna.</p>
      </div>
    </div>
  </section>

  <!-- COMPONENTES -->
  <section class="section alt" id="componentes">
    <div class="wrap">
      <p class="eyebrow">04 · Componentes</p>
      <h2>Piezas con peso</h2>
      <p class="lead">Todo es redondeado, grueso y táctil. Lo que se toca tiene una sombra inferior de 5 px que se aplasta al pulsar.</p>

      <h3>Botones con profundidad</h3>
      <p>Pulsa y mantén: el botón baja 4 px y la sombra se colapsa, como una ficha de madera.</p>
      <div class="demo row">
        <button class="btn" type="button">Continuar</button>
        <button class="btn btn-ok" type="button">Comprobar</button>
        <button class="btn btn-ghost" type="button">Ahora no</button>
        <button class="btn btn-night" type="button">Modo noche</button>
        <button class="btn" type="button" disabled>Desactivado</button>
      </div>

      <h3>Fichas de juego</h3>
      <p>Una ficha dice siempre lo mismo en cinco estados. El color nunca va solo: el estado también cambia de borde y de símbolo.</p>
      <div class="demo tiles">
        {[['normal', 'Normal', 'เสือ', 'tigre', ''], ['sel', 'Seleccionada', 'เสือ', 'tigre', 'Elegida'], ['ok', 'Correcta', 'เสือ', 'tigre', 'Correcta'], ['bad', 'Equivocada', 'เสื้อ', 'camisa', 'Casi'], ['done', 'Hecha', 'เสือ', 'tigre', 'Hecha']].map(([c, l, th, es, tag]) => (
          <div class="tile-w">
            <button type="button" class={`tile t-${c}`}>
              <span class="th" lang="th">{th}</span><span class="tes">{es}</span>
              {tag && <span class="ttag">{tag}</span>}
            </button>
            <small>{l}</small>
          </div>
        ))}
      </div>

      <h3>Chips de recompensa</h3>
      <div class="demo row">
        <span class="chip"><img class="lantern" src="/img/ico-farol.svg" alt="" width="28" height="28" />12 días</span>
        <span class="chip"><img src="/img/ico-platano.svg" alt="" width="28" height="28" />340 plátanos</span>
        <span class="chip"><img src="/img/ico-sello.svg" alt="" width="28" height="28" />7 sellos</span>
        <span class="chip"><img src="/img/ico-paraguas.svg" alt="" width="28" height="28" />2 paraguas</span>
        <span class="chip"><img src="/img/ico-curva.svg" alt="" width="28" height="28" />128 curvas</span>
      </div>
      <p class="note">Farolillo: racha diaria. Plátanos: puntos. Sellos: logros. Paraguas de Bo Sang: congela la racha. Curva: progreso.</p>

      <h3>Barra de progreso</h3>
      <div class="demo">
        <div class="prog" role="progressbar" aria-valuemin="0" aria-valuemax="1864" aria-valuenow="128" aria-label="Progreso del camino">
          <div class="prog-fill" style="width:7%"></div>
        </div>
        <p class="prog-t">Curva <b>128</b> de 1.864</p>
      </div>

      <h3>Noi habla</h3>
      <div class="demo noi-say">
        <Noi pose="celebra" size={120} still />
        <div class="bubble"><span class="th" lang="th">เก่งมาก!</span> <span class="rom">kèng mâak</span> · ¡qué crack!</div>
      </div>

      <h3>Hojas de respuesta</h3>
      <p>La hoja sube desde abajo tras cada respuesta. Nunca reprocha: indica la respuesta y sigue.</p>
      <div class="grid g2 sheets">
        <div class="sheet s-ok"><b>¡Muy bien!</b><span><span class="th" lang="th">ข้าว</span> <span class="rom">khâaw</span> · arroz</span><button class="btn btn-ok btn-sm" type="button">Continuar</button></div>
        <div class="sheet s-bad"><b>Casi.</b><span>Se dice <span class="th" lang="th">ข้าว</span> <span class="rom">khâaw</span>. <span class="th" lang="th">ไม่เป็นไร</span>, no pasa nada.</span><button class="btn btn-sm" type="button" style="--bg:var(--laca);--deep:var(--laca-hondo);--fg:#fff">Entendido</button></div>
      </div>
    </div>
  </section>

  <!-- MOVIMIENTO -->
  <section class="section" id="movimiento">
    <div class="wrap">
      <p class="eyebrow">05 · Movimiento</p>
      <h2>Peso y alegría</h2>
      <p class="lead">Noi pesa 1.200 kilos y es feliz. Todo se mueve como algo grande y contento: arranca con peso, llega con un pequeño rebote y se detiene sin prisa.</p>
      <div class="grid g3">
        {springs.map((s) => (
          <article class="card spring">
            <h3>{s.name}</h3>
            <p class="mono">rigidez {s.p.stiffness} · amortig. {s.p.damping}</p>
            <div class="track"><span class="ball" style={`--ease:${s.css};--t:${s.ms}ms`}></span></div>
            <p>{s.use}</p>
            <button class="btn btn-ghost btn-sm" type="button" data-play>Probar</button>
          </article>
        ))}
      </div>
      <h3 class="sp">Duraciones</h3>
      <ul class="durs">
        {[['tap', motion.dur.tap, 'Pulsar un botón'], ['rápido', motion.dur.rapido, 'Cambios de estado'], ['base', motion.dur.base, 'Entradas y salidas'], ['lento', motion.dur.lento, 'La niebla que se despeja'], ['historia', motion.dur.historia, 'Momentos de la historia']].map(([n, ms, u]) => (
          <li><b>{n}</b><span class="mono">{ms} ms</span><span>{u}</span><i style={`width:${Math.max(6, Number(ms) / 9)}%`}></i></li>
        ))}
      </ul>
      <div class="grid g2 sp">
        <article class="card"><h3>La niebla: {motion.nieblaMs / 1000} s</h3><p>La niebla deriva de lado a lado en {motion.nieblaMs / 1000} segundos. Es tan lenta que casi no se nota, como en la montaña.</p><div class="mist-demo" aria-hidden="true"><i></i><i></i></div></article>
        <article class="card"><h3>Movimiento reducido</h3><p>Si el sistema pide menos movimiento, desaparecen la niebla, los parpadeos, las orejas y los rebotes. Se conservan los cambios de estado, sin animar.</p></article>
      </div>
    </div>
  </section>

  <!-- SONIDO -->
  <section class="section alt" id="sonido">
    <div class="wrap">
      <p class="eyebrow">06 · Sonido</p>
      <h2>Suena a ranat</h2>
      <p class="lead">El ranat es el xilófono de madera de la música tradicional thai. Usamos su escala pentatónica: suene lo que suene, siempre queda bien.</p>
      <div class="grid g2 snd">
        <article class="card"><h3>Acierto</h3><p>Dos notas que suben, como una pregunta con respuesta.</p><button class="btn btn-sm" type="button" data-snd="ok">Escuchar</button></article>
        <article class="card"><h3>Error</h3><p>Un «tok» suave de madera. Sin zumbido ni buzzer: solo «inténtalo otra vez».</p><button class="btn btn-sm" type="button" data-snd="bad">Escuchar</button></article>
        <article class="card"><h3>Racha</h3><p>La campana de un templo, larga y cálida, cuando el farolillo sigue encendido.</p><button class="btn btn-sm" type="button" data-snd="streak">Escuchar</button></article>
        <article class="card"><h3>Fin de capítulo</h3><p>Un gong grave que cierra el tramo: llegaste a otra parada.</p><button class="btn btn-sm" type="button" data-snd="gong">Escuchar</button></article>
      </div>
      <p class="note">Las demos se sintetizan en tu navegador y solo suenan cuando pulsas. Los sonidos reales de la app son archivos propios.</p>
    </div>
  </section>

  <!-- HÁPTICA -->
  <section class="section" id="haptica">
    <div class="wrap">
      <p class="eyebrow">07 · Háptica</p>
      <h2>Se siente antes de verse</h2>
      <p class="lead">La vibración repite lo que dicen el sonido y el movimiento, nunca lo sustituye. Siempre se puede desactivar.</p>
      <div class="table-wrap"><table class="plain">
        <thead><tr><th scope="col">Momento</th><th scope="col">Sensación</th></tr></thead>
        <tbody>
          <tr><th scope="row">Pulsar un botón</th><td>Toque ligero, como una ficha sobre la mesa.</td></tr>
          <tr><th scope="row">Acierto</th><td>Un toque limpio y firme.</td></tr>
          <tr><th scope="row">Error</th><td>Dos toques suaves, nunca un golpe.</td></tr>
          <tr><th scope="row">Racha</th><td>Un pulso medio, como una campana lejana.</td></tr>
          <tr><th scope="row">Fin de capítulo</th><td>Un pulso largo que se apaga.</td></tr>
        </tbody>
      </table></div>
    </div>
  </section>

  <!-- NOI -->
  <section class="section alt" id="noi">
    <div class="wrap">
      <p class="eyebrow">08 · Noi</p>
      <h2>Anatomía de una elefanta pequeña</h2>
      <div class="anat">
        <div class="anat-fig"><Noi pose="feliz" size={300} /></div>
        <ol class="anat-list">
          <li><b>Cabeza grande y ojos enormes.</b> Tres brillos en cada ojo y pestañas largas: se le nota todo lo que siente.</li>
          <li><b>Orejas grandes con pecas rosas.</b> Las pecas son un rasgo real de las elefantas asiáticas mayores.</li>
          <li><b>Sin colmillos.</b> Como la mayoría de las elefantas asiáticas.</li>
          <li><b>Sombrero de exploradora con frangipani.</b> La flor blanca de los templos (ลีลาวดี) prendida en la cinta.</li>
          <li><b>Pañuelo pha khao ma.</b> La tela de cuadros que se lleva en todo el país, anudada al cuello.</li>
          <li><b>Mochila índigo de rayas Lanna.</b> Llena de plátanos, por si el camino se alarga.</li>
        </ol>
      </div>
      <p>Cada capa del dibujo tiene su clase, para animarla por separado: {layers.map((l, i) => <><code>noi-{l.replace(/([A-Z])/g, (m) => '-' + m.toLowerCase())}</code>{i < layers.length - 1 ? ', ' : '.'}</>)}</p>
      <h3 class="sp">Siete poses</h3>
      <ul class="poses">
        {NOI_POSES.map((p) => <li><Noi pose={p} size={130} still /><b>{p}</b><span>{poseUse[p]}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- VOZ -->
  <section class="section" id="voz">
    <div class="wrap">
      <p class="eyebrow">09 · Voz y tono</p>
      <h2>Cómo habla Sanuk</h2>
      <p class="lead">Curiosa, cálida y nunca regaña. Habla como una amiga que ya conoce el camino y que te lo cuenta sin prisa.</p>
      <div class="grid g3">
        <article class="card"><h3>Hablamos de tú</h3><p>En español de España, cercano y directo. Con humor suave y cero sermones.</p></article>
        <article class="card"><h3>Celebramos lo pequeño</h3><p>Una palabra aprendida ya es una curva menos. Noi lo dice así: <span class="th" lang="th">เก่งมาก!</span> «¡qué crack!»</p></article>
        <article class="card"><h3>Los fallos no se castigan</h3><p>Nada de «incorrecto» ni «fallaste». Se dice la respuesta y se sigue: <span class="th" lang="th">ไม่เป็นไร</span>.</p></article>
      </div>
