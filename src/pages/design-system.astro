<script>
  // Muelles: calculamos la distancia disponible y alternamos la posición.
  document.querySelectorAll<HTMLElement>('[data-play]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const ball = btn.closest('.spring')!.querySelector<HTMLElement>('.ball')!;
      const track = ball.parentElement!;
      ball.style.setProperty('--dist', `${track.clientWidth - 56}px`);
      ball.classList.toggle('go');
    });
  });

  // Sonido: síntesis simple y pentatónica, solo tras un clic.
  let ctx: AudioContext | null = null;
  const pent = [0, 2, 4, 7, 9]; // pentatónica mayor
  const f = (deg: number, base = 523.25) => base * Math.pow(2, (pent[deg % 5]! + 12 * Math.floor(deg / 5)) / 12);
  function tone(freq: number, t: number, dur: number, type: OscillatorType, vol: number, partials = 1) {
    if (!ctx) return;
    for (let p = 1; p <= partials; p++) {
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.type = type; o.frequency.value = freq * (p === 1 ? 1 : p * 1.5 + 0.5);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol / (p * p), t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur / (p === 1 ? 1 : p * 0.7));
      o.connect(g).connect(ctx.destination); o.start(t); o.stop(t + dur + 0.1);
    }
  }
  function play(kind: string) {
    ctx ??= new AudioContext();
    const t = ctx.currentTime + 0.02;
    if (kind === 'ok') { tone(f(0), t, 0.35, 'triangle', 0.22, 2); tone(f(2), t + 0.13, 0.55, 'triangle', 0.22, 2); }
    if (kind === 'bad') { tone(190, t, 0.12, 'sine', 0.3); tone(380, t, 0.06, 'triangle', 0.1); }
    if (kind === 'streak') { tone(f(3, 392), t, 2.2, 'sine', 0.2, 4); }
    if (kind === 'gong') { tone(f(0, 98), t, 3, 'sine', 0.3, 4); }
  }
  document.querySelectorAll<HTMLElement>('[data-snd]').forEach((b) => b.addEventListener('click', () => play(b.dataset.snd!)));
</script>
